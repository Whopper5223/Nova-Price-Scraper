{"nodes": [{"id": "readme_nova_price_scraper", "label": "Nova-Price-Scraper README", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scraper_core_py", "label": "scraper/core.py (shared browser/selector/search/store-lookup core)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scraper_run_scraper_py", "label": "scraper/run_scraper.py (CLI: full store/department scrape)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scraper_product_search_py", "label": "scraper/product_search.py (CLI: product name search, price range per store)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scraper_recipe_scraper_py", "label": "scraper/recipe_scraper.py (CLI: recipe URL to ingredient price comparison)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scraper_instacart_scraper_py", "label": "scraper/instacart_scraper.py (full-catalog crawl logic)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scraper_selector_healer_py", "label": "scraper/selector_healer.py (Gemini-powered selector self-healing)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scraper_selectors_json", "label": "scraper/selectors.json (current CSS selectors)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scraper_requirements_scraper_txt", "label": "scraper/requirements-scraper.txt (Python dependencies)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scraper_session_json", "label": "scraper/session.json (saved Instacart login session)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scraper_prices_output_json", "label": "scraper/prices_output.json (run_scraper results)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scraper_product_search_output_json", "label": "scraper/product_search_output.json (product_search results)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scraper_recipe_output_json", "label": "scraper/recipe_output.json (recipe_scraper results)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_gemini_api_self_healing", "label": "Gemini API selector self-healing", "file_type": "rationale", "rationale": "CSS selectors on Instacart break as the site changes; instead of hard failure, broken selectors are repaired at runtime via the Gemini API (optional GEMINI_API_KEY), keeping the scraper working without manual selector maintenance. A fixed set of healable selector keys (address_input, product_price, store_card, etc.) bounds what the healer may rewrite, and --heal-only with an --html-file allows offline repair against saved debug HTML.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_store_lookup_3_stage", "label": "3-stage store lookup", "file_type": "rationale", "rationale": "--stores is not limited to Instacart's visible storefront page. Lookup tries, in order: (1) the visible storefront list, (2) Instacart's own search bar, (3) a direct URL guess. This lets any store that delivers to the address (e.g. Hannaford) be found and searched even when it is absent from the storefront page. Shared by product_search and recipe_scraper via the core module.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_playwright", "label": "Playwright (Chromium browser automation)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_beautifulsoup4", "label": "BeautifulSoup4 (bs4 HTML parsing)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_multi_recipe_selection", "label": "Multi-recipe page selection (--recipe flag)", "file_type": "rationale", "rationale": "Recipe pages are often roundups ('10 best...' lists) containing several recipes. The --recipe flag selects one by number or by name; without it the first recipe is used and the full list of found recipes is printed so the user can re-run with an explicit choice.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_delivery_address_env", "label": "Env-driven delivery address (DELIVERY_ADDRESS / --address)", "file_type": "rationale", "rationale": "The delivery address is no longer hardcoded: it comes from a DELIVERY_ADDRESS variable in the repo-root .env (gitignored), with a --address CLI flag as a one-off override. The same address must be set during the --login browser session so the saved session and env agree.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_department_product_caps", "label": "Full-department crawl with product caps", "file_type": "rationale", "rationale": "run_scraper scrapes every department by default (150 products per department, 5 stores); --departments narrows to named departments, --max-products caps per department, --max-per-store caps total per store, and --max-stores 0 means every store found. Caps of 0 mean unlimited. Lowering caps and avoiding --headless is also the recommended mitigation for bot-blocking/CAPTCHAs.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_price_range_matching", "label": "Filtered min-max price range per search term", "file_type": "rationale", "rationale": "Product and ingredient prices are reported as a min-max range across top search matches rather than a single guess; only products whose name actually contains the search terms count toward the range, so searching 'butter' is not skewed by 'butter cookies'. --results widens the range by considering more matches per store.", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_nova_price_scraper", "target": "scraper_core_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_nova_price_scraper", "target": "scraper_run_scraper_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_nova_price_scraper", "target": "scra